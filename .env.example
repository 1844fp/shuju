# 本地开发模板；当前尚无运行服务
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=postgresql+psycopg://finagent:CHANGE_ME@localhost:5432/finagent
REDIS_URL=redis://localhost:6379/0
LLM_MODE=disabled
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
AUTH_SECRET=
UPLOAD_MAX_BYTES=10485760
SQL_MAX_ROWS=1000
SQL_TIMEOUT_SECONDS=5

# demo保留本机演示；初始化管理员后才设置users
FINAGENT_AUTH_MODE=demo
FINAGENT_COOKIE_SECURE=0

# 可选原生PostgreSQL分析数仓（先执行迁移，不改变接入库）
FINAGENT_WAREHOUSE_URL=

# OpenAI兼容API：密钥最后由用户在本地填写，不要发送聊天
FINAGENT_MODEL_API_KEY=
FINAGENT_MODEL=
FINAGENT_MODEL_BASE_URL=
FINAGENT_ALLOW_MODEL_NETWORK=0
# 生产数仓独立读登录：以组织UUID为键的JSON，配置值含敏感信息
FINAGENT_WAREHOUSE_PRODUCTION=0
FINAGENT_WAREHOUSE_READERS_JSON={}
